# dola-pool 配置文件（install.sh 会基于本模板生成 dola.env）
# 格式：KEY=VALUE，一行一个；注释必须单独占一行（systemd 不支持行尾注释）。
# 修改后执行 sudo systemctl restart dola-pool 生效。完整变量见 config.py 与 deploy/README.md。

TZ=Asia/Shanghai

# ---------- 监听与对外地址 ----------
# 配了域名时只监听本机、由 nginx 对外；没域名时监听 0.0.0.0 直接用 IP:端口 访问
DOLA_HOST=127.0.0.1
DOLA_PORT=8002
# 生成 video_url 用的对外地址，必须是调用方能访问到的地址
DOLA_PUBLIC_BASE=http://127.0.0.1:8002

# ---------- 对外 API Key ----------
# 环境变量 Key 不受任何额度限制，逗号分隔多个；给客户的 Key 请在面板「API 密钥」里创建
DOLA_API_KEYS=sk-dola-REPLACE_ME

# ---------- 代理 ----------
# dola.com 只允许日本/韩国 IP。推荐在面板「代理管理」里给每个号单独配代理；
# 这里是没配代理的号使用的全局默认代理，留空 = 直连（服务器本身在日韩时可留空）
# 例：DOLA_PROXY=http://user:pass@jp-proxy.example.com:3128
DOLA_PROXY=

# ---------- 并发与队列 ----------
# 全局同时出片数，0 = 不限
DOLA_MAX_CONCURRENCY=0
# 待处理任务上限，超出直接返回 429
DOLA_MAX_PENDING_TASKS=500

# ---------- 号池额度 ----------
# 每个号每天的点数（seedance-2.5 每条 2 点，seedance-2.0 每条 3 点）
DOLA_DAILY_LIMIT=4
# 每天按这个时区 0 点重置额度（东京 0 点 = 北京 23 点）
DOLA_LIMIT_RESET_TZ=Asia/Tokyo

# ---------- 上游限流（710022002 访问频繁）----------
# 某个出口 IP 被上游限流后，该出口上的号暂停多少秒（连续被拒翻倍，封顶 900）；0 = 关闭
DOLA_EGRESS_THROTTLE_SECONDS=120
# 同一出口 10 分钟内至少几个不同的号被限流，才判定是 IP 被限、整个出口一起暂停（1 个号时只暂停那个号）
DOLA_EGRESS_THROTTLE_MIN_ACCOUNTS=2
# 批量「你好探测」：并发 1 = 串行，每个号间隔 3 秒
DOLA_HELLO_PROBE_CONCURRENCY=1
DOLA_HELLO_PROBE_INTERVAL=3
# 面板提示：同一出口 IP 上的号超过这个数就提醒
DOLA_EGRESS_SHARE_WARN=3
# 号吃到 710022002 后进【异常】组暂停派发的起步时长（秒；0 = 不暂停该号）
DOLA_THROTTLE_ACCOUNT_COOLDOWN_SECONDS=1800
# 同一个号连续被限流时暂停时长翻倍，封顶多少秒（默认 8 小时）
DOLA_THROTTLE_ACCOUNT_COOLDOWN_MAX_SECONDS=28800

# ---------- 扣点表（可选，覆盖内置的「模型 + 时长」报价）----------
# DOLA_DURATION_COSTS=seedance-2.5:5=2,10=4,15=12;seedance-2.0:10=2

# ---------- 30 秒 ----------
# dola 自 2026-10-12 起单条最长 15 秒。reject = 30 秒直接拒绝（默认，不占额度）；
# pair = 两次「请求 30 秒」（dola 各压成 15 秒、各扣 2 点）拼成 30 秒，共 4 点；native = 按 30 秒原样提交
DOLA_30S_MODE=reject

# ---------- 出片等待 ----------
# 单次出片默认最多等多久（秒）；上游说「预计等待 N 分钟」时会自动放长，但不超过 DOLA_PURE_TIMEOUT_MAX
DOLA_PURE_TIMEOUT=900
DOLA_PURE_TIMEOUT_MAX=3600
# 超时任务自动取回：判超时后在后台继续盯 dola 会话多久（秒，0 = 关闭）、多久查一次
DOLA_RECOVER_TIMEOUT_SECONDS=10800
DOLA_RECOVER_INTERVAL_SECONDS=120
# 30 秒任务（不拼接）上游回「只支持 4~15 秒」后最多再等多久出片（秒）
DOLA_30S_CAP_GRACE_SECONDS=600

# ---------- 存储 ----------
# 成片与任务记录保留天数，超过自动清理
DOLA_TASK_RETENTION_DAYS=14

# ---------- 上游与浏览器 ----------
# cookie 号走纯 HTTP 出片（需要 Node.js 做签名）
DOLA_PURE_API=1
# Cookie 账号运行时：pure = 纯 HTTP（默认）；cloak = Dola Cookie 账号固定走 CloakBrowser 独立 profile。
# cloak 模式下浏览器不可用不会静默回退纯 API；豆包 Cookie 账号仍走豆包纯 API。
DOLA_COOKIE_RUNTIME=pure
DOLA_COOKIE_PROFILE_SUBDIR=cloak-profile
DOLA_CLOAK_HEADLESS=0
DOLA_CLOAK_HUMANIZE=0
DOLA_CLOAK_GEOIP=0
# CLOAKBROWSER_CACHE_DIR=/opt/dola-pool/.cloakbrowser
# CLOAKBROWSER_LICENSE_KEY=
# 严格模式的限流保护：固定出口、同出口不并发、710022002 不自动换 IP。
# 启用 DOLA_COOKIE_RUNTIME=cloak 时取消下面四行的注释：
# DOLA_ISOLATE_SHARED_EGRESS=1
# DOLA_EGRESS_THROTTLE_ROTATE=0
# DOLA_EGRESS_THROTTLE_MIN_ACCOUNTS=1
# DOLA_MIN_SUBMIT_INTERVAL_SECONDS=15
# 无水印解析：1 = 调用第三方接口 http://47.104.150.143:8765（会把视频播放信息发给对方）；
# 0 = 不用第三方，只用 dola 自己返回的无水印直链。原理与风险见 USAGE.md「去水印说明」
# 2026-10 起该第三方接口长期连不上（每条视频白等约 2 分钟超时），而 dola 直链一直是无水印的，所以模板默认 0
DOLA_PURE_REMOVE_WATERMARK=0
DOLA_HEADLESS=1
DOLA_EXTENSION_ENABLED=1
# Node.js 可执行文件路径（留空则从 PATH 里找）
DOLA_NODE=
# patchright 的 Chromium 安装位置
PLAYWRIGHT_BROWSERS_PATH=
