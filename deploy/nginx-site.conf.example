# 宝塔「网站 → 你的域名 → 配置文件」里与本次服务相关的关键片段。
# 面板生成的部分（SSL / well-known / 敏感文件拦截 / 监控日志）保持原样，只关注下面这些：

server
{
    listen 80;
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;                      # 例：dola.example.com
    root /www/wwwroot/YOUR_DOMAIN;

    #CERT-APPLY-CHECK--START
    # 用于SSL证书申请时的文件验证相关配置 -- 请勿删除
    include /www/server/panel/vhost/nginx/well-known/YOUR_DOMAIN.conf;
    #CERT-APPLY-CHECK--END

    # 画布/客户端会 multipart 传参考图，宝塔默认 1m 会 413
    client_max_body_size 64m;

    # 一键申请SSL证书验证目录：必须放行，否则证书申请/续签失败
    location ~ \.well-known {
        allow all;
    }

    # 反向代理到本服务（8000 只监听 127.0.0.1，不对外）
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        # 30 秒档出片要 6~20 分钟，别用默认 60s 掐断轮询
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        send_timeout 1800s;
        # 出片/轮询都是流式的，关掉缓冲更及时
        proxy_buffering off;
    }

    access_log  /www/wwwlogs/YOUR_DOMAIN.log;
    error_log   /www/wwwlogs/YOUR_DOMAIN.error.log;
}

# 说明：
# 1) 宝塔面板里对应操作是「网站 → 域名 → 反向代理 → 目标 http://127.0.0.1:8000」；
#    用面板建的反代会在 vhost 里生成 include .../proxy/<域名>/*.conf，本片段是等价写法。
# 2) SSL 用面板一键 Let's Encrypt；申请时的文件验证由 well-known 目录 + 上面的 allow all 完成。
# 3) 若站点还挂着旧的 PHP include（enable-php-74.conf），可改成 enable-php-00.conf（纯静态+反代）。
