# Studio-only configuration. Copy to .env.local in this directory.
# The run.py CLI controls the listening host/port (127.0.0.1:8001 by default).
DOLA_PUBLIC_BASE=http://127.0.0.1:8001

# Optional admin key and API keys; use your own values if needed.
DOLA_ADMIN_KEY=
DOLA_API_KEYS=
DOLA_ALLOW_SELF_REGISTER=0

# Keep these paths local to Studio; do not reuse the root edition databases.
DOLA_ACCOUNTS_DIR=accounts
DOLA_DB_PATH=tasks.db
DOLA_POOL_DB_PATH=pool_usage.db
DOLA_PROXY_USAGE_DB=proxy_usage.db
DOLA_DOWNLOAD_DIR=downloads
DOLA_REFERENCE_UPLOAD_DIR=uploads/references

# Dola browser/HTTP route. Set this to your own local proxy, or leave empty.
DOLA_PROXY=
DOUBAO_ENABLED=0
